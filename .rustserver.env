# Rust Administration & Control System
#
# Rust server configuration dot-env
#
# Centralised environment configuration matrix. Used concurrently by rustacs,
# [systemd] rustserver.service, and custom automation scripts.
#
# 2026-09-23 Exaga - penthux.net
#
### 


### RUST GLOBAL CONFIG 

# RUST dot-env config PATH
RUST_SERVER_ENV="/home/rust/.rustacs/.rustserver.env"

# RUST master config PATH
RUST_MASTER_CONFIG="/home/rust/.rustacs/master.config"


### RUST [SYSTEMD] SERVICE

# Rust service PATH
RUST_SERVICE_PATH=/etc/systemd/system/rustserver.service


### RUST USER/GROUP

# Rust user ACCOUNT
RUST_USERNAME=rust

# Rust user GROUP
RUST_USERGROUP=rust


### RUST INFRASTRUCTURE PATHS

# Rust user HOME dir
RUST_USER_HOME=/home/rust

# Rust installation working directory PATH
RUST_INSTALL_WORKDIR=/home/rust/rustserver

# Rust server world file directory PATH
RUST_SERVER_FILEDIR=/home/rust/rustserver/server


### RUST GAME SERVER CONFIG

# Rust server IP
RUST_SERVER_IP=0.0.0.0

# Rust server HOSTNAME
RUST_SERVER_HOSTNAME=RUSTACS

# Rust server IDENTITY
RUST_SERVER_ID=RustACS

# Rust server PORT
RUST_SERVER_PORT=28015

# Rust server QUERYPORT
RUST_SERVER_QUERYPORT=28017

# Rust server SEED
RUST_SERVER_SEED=123456789

# Rust server WORLDSIZE size
RUST_SERVER_WORLDSIZE=4500

# Rust server LEVEL
RUST_SERVER_LEVEL="Procedural Map"

# Rust server MAXPLAYERS
RUST_SERVER_MAXPLAYERS=10

# Rust server TUTORIAL Enabled [true] | Disabled [false]
RUST_SERVER_TUTORIAL=true

# Rust server TAGS
RUST_SERVER_TAGS=monthly,US,tut

# Rust server SAVE interval
RUST_SERVER_SAVEINTERVAL=600


### RUST RCON

# Rust RCON Enabled [1] | Disabled [0]
RUST_RCON_WEB=1

# Rust RCON IP address
RUST_RCON_IP=127.0.0.1

# Rust RCON PORT
RUST_RCON_PORT=28016

# Rust RCON passwd
RUST_RCON_PASSWORD=your-RCON-passwd


### RUSTACS PATH

# rustacs executable PATH
RUSTACS_PATH=/home/rust/bin/rustacs

# rustacs version
RUSTACS_VERSION=2.2.5


### STEAMCMD PATH

# SteamCMD PATH
STEAMCMD_PATH="/usr/games/steamcmd"


### RUST BACKUPS

# Rust BACKUPS directory
RUST_BACKUP_DIR=/home/rust/backups

# Rust server BACKUP file retention [days]
RUST_BACKUP_RETENTION=31


### RUST LOGGING

# Rust logging directory PATH
RUST_LOGDIR=/home/rust/logs

# Rust server LOGFILE basename
RUST_SERVER_LOGFILE=rustserver

# Rust server logfile MAX size [MiB]
RUST_SERVER_MAX_LOGFILE=2


#EOF<*>
