def print_help():
    print(f"""rustacs v{rustacs_version()} [Python 3]
{DESCRIPTION}

Usage:
  rustacs <command> [arguments]
  rustacs [options]

Examples:
  rustacs status
  rustacs status --verbose
  rustacs serverinfo
  rustacs say "Hello World!"
  rustacs server.save
  rustacs server start
  rustacs server stop
  rustacs server restart
  rustacs server status

Options:
  -h, -?, --help          Show this help
  -v, --version           Show version information
  -U, --url               Show official RUSTACS project URL
  -L, --license           Show license information
  <command> --verbose     Show detailed errors for the command""")


def print_version():
    print(f"""rustacs v{rustacs_version()} [Python 3]
{DESCRIPTION}
{PROJECT_URL}
(c) 2026 penthux.net""")


def read_dotenv(path):
    values = {}

    try:
        with open(path, "r", encoding="utf-8") as f:
            for raw_line in f:
                line = raw_line.strip()

                if not line or line.startswith("#") or "=" not in line:
                    continue

                key, value = line.split("=", 1)
                key = key.strip()
                value = value.strip()

                if len(value) >= 2 and value[0] == value[-1] and value[0] in ("'", '"'):
                    value = value[1:-1]

                values[key] = value

    except FileNotFoundError:
        print(f"Error: dot-env file not found at {path}", file=sys.stderr)
        sys.exit(1)
    except PermissionError:
        print(f"Error: permission denied reading {path}", file=sys.stderr)
        print("Check that your user is in the 'rust' group.", file=sys.stderr)
        sys.exit(1)
    except OSError as exc:
        print(f"Error: unable to read {path}: {exc}", file=sys.stderr)
        sys.exit(1)

    return values


def require_value(env, name):
    value = env.get(name)
    if not value:
        print(f"Error: {name} not found in {ENV_FILE_PATH}", file=sys.stderr)
        sys.exit(1)
    return value


def rustacs_version():
    env = read_dotenv(ENV_FILE_PATH)
    return require_value(env, "RUSTACS_VERSION")


def connection_error(exc, verbose):
    print(
        "Connection failed: Server is offline or RCON IP/port is misconfigured.",
        file=sys.stderr,
    )
    if verbose:
        print(f"Detail: {exc}", file=sys.stderr)


def print_rcon_message(command, raw_response):
    data = json.loads(raw_response)
    message = data.get("Message")

    if message is None or message == "":
        return

    if not isinstance(message, str):
        print(message)
        return

    message = message.strip()
    if not message:
        return

    if command == "serverinfo":
        try:
            server_info = json.loads(message)
        except json.JSONDecodeError:
            print(message)
            return

        if isinstance(server_info, (dict, list)):
            print(json.dumps(server_info, indent=2))
            return

    print(message)


async def send_command(command, verbose):
    env = read_dotenv(ENV_FILE_PATH)

    rcon_ip = require_value(env, "RUST_RCON_IP")
    rcon_password = require_value(env, "RUST_RCON_PASSWORD")
    rcon_port = require_value(env, "RUST_RCON_PORT")

    try:
        port = int(rcon_port)
        if not 1 <= port <= 65535:
            raise ValueError
    except ValueError:
        print(f"Error: invalid RUST_RCON_PORT in {ENV_FILE_PATH}: {rcon_port}", file=sys.stderr)
        return 1

    if websockets is None:
        print("Connection failed: Python 'websockets' module is not installed.", file=sys.stderr)
        if verbose:
            print("Detail: install the Python websockets package for this environment.", file=sys.stderr)
        return 1

    uri = f"ws://{rcon_ip}:{port}/{rcon_password}"
    payload = {
        "Identifier": 1,
        "Message": command,
        "Name": "WebRCON",
    }

    try:
        async with websockets.connect(uri, open_timeout=8, close_timeout=1) as websocket:
            await websocket.send(json.dumps(payload))
            raw_response = await asyncio.wait_for(websocket.recv(), timeout=5)
            print_rcon_message(command, raw_response)
            return 0

    except Exception as exc:
        connection_error(exc, verbose)
        return 1


def run_server_command(action, verbose):
    env = read_dotenv(ENV_FILE_PATH)
    service_path = require_value(env, "RUST_SERVICE_PATH")

    if not os.path.isfile(service_path):
        print(f"Error: Rust server service unit not found: {service_path}", file=sys.stderr)
        return 1

    service_unit = os.path.basename(service_path)
    systemctl = "/usr/bin/systemctl"

    if action == "status":
        display = [systemctl, "is-active", service_unit]
        print(" ".join(display))
        result = subprocess.run(display, check=False)
        return result.returncode

    messages = {
        "start": "Starting Rust server ...",
        "stop": "Shutting down Rust server ...",
        "restart": "Restarting Rust server ...",
    }

    display = [systemctl, action, service_unit]
    actual = ["sudo", systemctl, action, service_unit]

    print(" ".join(display))
    print(messages[action])

    try:
        result = subprocess.run(actual, check=False)
    except FileNotFoundError as exc:
        print("Error: unable to execute sudo.", file=sys.stderr)
        if verbose:
            print(f"Detail: {exc}", file=sys.stderr)
        return 1
    except OSError as exc:
        print(f"Error: unable to manage Rust server service: {exc}", file=sys.stderr)
        return 1

    return result.returncode


def parse_command_line(argv):
    if not argv:
        print_help()
        return None, False, 1

    if len(argv) == 1:
        option = argv[0]

        if option in ("-h", "-?", "--help"):
            print_help()
            return None, False, 0
        if option in ("-v", "--version"):
            print_version()
            return None, False, 0
        if option in ("-U", "--url"):
            print("RUSTACS project (GitHub) URL:")
            print(PROJECT_URL)
            return None, False, 0
        if option in ("-L", "--license"):
            print(LICENSE_TEXT)
            return None, False, 0
        if option == "--verbose":
            print_help()
            return None, False, 0

    verbose = False
    command_parts = []

    for arg in argv:
        if arg == "--verbose":
            verbose = True
        else:
            command_parts.append(arg)

    if not command_parts:
        print_help()
        return None, verbose, 0

    return command_parts, verbose, None


def main():
    command_parts, verbose, immediate_status = parse_command_line(sys.argv[1:])

    if immediate_status is not None:
        return immediate_status

    if command_parts[0] == "server" and len(command_parts) == 2:
        action = command_parts[1]
        if action in ("start", "stop", "restart", "status"):
            return run_server_command(action, verbose)

    command = " ".join(command_parts)
    return asyncio.run(send_command(command, verbose))


if __name__ == "__main__":
    sys.exit(main())

